# Copy this file to .env and replace the placeholder.
# .env is ignored by Git and must never be committed.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional operator identity. If omitted, Maid-chan addresses you as 您.
# MAID_CHAN_OPERATOR_NAME=Hehao
# MAID_CHAN_OPERATOR_HONORIFIC=大人

# For another OpenAI-compatible provider, use:
# OPENAI_API_KEY=your-provider-api-key
# OPENAI_BASE_URL=https://provider.example/v1
# OPENAI_MODEL=provider-model-id

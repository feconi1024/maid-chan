{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maid-chan.local/schemas/external-memory-1.1.json",
  "title": "Maid-chan External Memory Interchange 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "subject", "source", "memories"],
  "properties": {
    "format": {
      "const": "maid-chan-memory"
    },
    "version": {
      "const": "1.1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "exported_at"],
      "properties": {
        "platform": {
          "$ref": "#/$defs/identifier"
        },
        "exported_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "memories": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/memory"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "privacy_rating"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "identity",
            "biography",
            "preference",
            "relationship",
            "goal",
            "project",
            "routine",
            "constraint",
            "communication",
            "other"
          ],
          "default": "other"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "privacy_rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum audience privacy clearance required to use this memory."
        },
        "sensitivity": {
          "enum": ["public", "private", "restricted"],
          "default": "private",
          "deprecated": true
        },
        "status": {
          "enum": ["active", "superseded", "deleted"],
          "default": "active"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "default": []
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_from": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "extracted_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
